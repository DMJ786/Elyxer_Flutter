# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Coverage
coverage/

# Generated files (Freezed, json_serializable, Riverpod)
# Note: *.g.dart and *.freezed.dart are tracked intentionally
# Do NOT add *.g.dart or *.freezed.dart here

# Analysis & test output
analyze_results.txt
test_evidence.txt

# Secrets & credentials — NEVER commit these
.env
.env.*
.env.local
.env.production
.env.staging
*.pem
*.key
*.p12
*.jks
*.keystore
*.pfx
**/key.properties
**/local.properties
**/google-services.json
**/GoogleService-Info.plist
**/service-account*.json
**/credentials*.json
**/secrets*.json
**/*token*.json

# Exceptions to above rules
!**/ios/**/default.mode1v3
!**/ios/**/default.mode2v3
!**/ios/**/default.pbxuser
!**/ios/**/default.perspectivev3
