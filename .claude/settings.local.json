{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/*.pfx)",
      "Read(**/credentials*)",
      "Read(**/secrets*)",
      "Read(**/*secret*)",
      "Read(**/service-account*)",
      "Read(**/google-services.json)",
      "Read(**/GoogleService-Info.plist)",
      "Read(**/key.properties)",
      "Read(**/local.properties)",
      "Read(**/*token*.json)",
      "Bash(cat *.env*)",
      "Bash(cat *.pem)",
      "Bash(cat *.key)",
      "Bash(printenv*)",
      "Bash(echo $*)",
      "Bash(set | grep*)"
    ],
    "allow": [
      "WebFetch(domain:www.figma.com)",
      "Bash(flutter test*)",
      "Bash(flutter analyze*)",
      "Bash(flutter pub run build_runner*)",
      "Bash(flutter pub get*)",
      "Bash(flutter pub outdated*)",
      "Bash(flutter build*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "Bash(git stash*)",
      "Bash(git checkout*)",
      "Bash(git pull*)",
      "Bash(git push*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(gh pr*)",
      "Bash(claude --version)",
      "Bash(npm update -g @anthropic-ai/claude-code)"
    ]
  }
}
