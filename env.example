# Elyxer Flutter — environment configuration template
#
# This file is committed; the *real* values are passed at build/run time via
# `--dart-define=KEY=value` (compile-time, no runtime file load, no asset
# bundling). This respects the project rule "NEVER commit .env*" while still
# documenting what knobs the build accepts.
#
# Usage examples:
#
#   flutter run \
#     --dart-define=API_BASE_URL=https://asia-south1-elyxer-dev.cloudfunctions.net \
#     --dart-define=MAPBOX_TOKEN=pk.eyJ1Ijoi... \
#     --dart-define=GOOGLE_PLACES_KEY=AIzaSy... \
#     --dart-define=USE_FIREBASE_EMULATOR=false
#
#   flutter build apk \
#     --dart-define=API_BASE_URL=... --dart-define=MAPBOX_TOKEN=...
#
# In Android Studio / VS Code launch configs, add the same args under
# "additionalArgs" / "args".

# === Cloud Functions BFF ===

# Base URL of the deployed Cloud Functions BFF (per-environment placeholders).
# Dev is the built-in default (used if you don't pass --dart-define). Until the
# GCP project is provisioned (see docs/DEPLOY.md, issue #40) this URL 404s —
# that's expected; it becomes live after the first `firebase deploy`.
#   dev     https://asia-south1-elyxer-dev.cloudfunctions.net
#   staging https://asia-south1-elyxer-staging.cloudfunctions.net
#   prod    https://asia-south1-elyxer-prod.cloudfunctions.net
API_BASE_URL=https://asia-south1-elyxer-dev.cloudfunctions.net

# Region your Firebase Functions are deployed to. Must match firebase.json.
CLOUD_FUNCTIONS_REGION=asia-south1

# Point Flutter at the local emulator suite instead of production.
# Set to true when running `firebase emulators:start`.
USE_FIREBASE_EMULATOR=false

# === Client-safe API tokens (restricted by bundle ID / referrer) ===

# Mapbox public access token. Restrict by bundle ID in the Mapbox dashboard.
# https://account.mapbox.com/access-tokens/
MAPBOX_TOKEN=

# Google Places (New) API key. Restrict by Android package + SHA-1 / iOS bundle ID.
# https://console.cloud.google.com/apis/credentials
# Only required for India users (Bundle 2). Leave blank if not testing IN flow.
GOOGLE_PLACES_KEY=

# === Cloud Functions runtime env (server-side, NOT --dart-define) ===
#
# Set at deploy time via functions/.env (auto-loaded by Functions v2 — never
# commit it) or the Firebase Console → Functions → Configuration. All have safe
# defaults in code (functions/src/ai/vertex.ts), so a deploy works without them.
# Non-secret:
#   GCLOUD_PROJECT             # provided automatically by the runtime
#   VERTEX_REGION=asia-south1
#   CLAUDE_MODEL=claude-haiku-4-5
#   CLAUDE_MAX_OUTPUT_TOKENS=800
# Secret (bind from Secret Manager, required by every authed endpoint):
#   DATABASE_URL=postgres://…    # Cloud SQL connection string — see docs/DEPLOY.md §4

# === Server-side secrets (NOT in this file) ===
#
# The following secrets live in Firebase Functions runtime config and never
# touch the Flutter app:
#
#   firebase functions:config:set \
#     resend.api_key="re_..." \
#     msg91.auth_key="..." \
#     msg91.template_id="..." \
#     sightengine.api_user="..." \
#     sightengine.api_secret="..." \
#     aws.access_key_id="..." \
#     aws.secret_access_key="..." \
#     aws.region="ap-south-1" \
#     cloudflare.r2_account_id="..." \
#     cloudflare.r2_access_key="..." \
#     cloudflare.r2_secret_key="..." \
#     cloudflare.r2_bucket="elyxer-photos" \
#     cloudflare.images_account_hash="..."
#
# Pull them in functions code via `functions.config().resend.api_key` etc.
