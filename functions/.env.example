# Copy to .env for local development. Never commit .env — it's gitignored.
#
# Cloud SQL production values live in Google Secret Manager and are
# injected into the deployed function at runtime; do not put prod
# credentials here.

# Local Docker Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql://elyxer:elyxer_dev@localhost:5432/elyxer_dev

# Set to "true" to log every SQL statement Kysely emits (dev only).
DB_DEBUG_LOG=false

# --- Vertex AI (Anthropic Claude via Google Vertex Model Garden) ---
# Prod: injected from the Cloud Functions runtime — GCLOUD_PROJECT is
# always set; VERTEX_REGION defaults to asia-south1 (Mumbai) to keep
# the LLM round-trip inside the same region as our Functions.
# Local: set these to your dev GCP project + run
#   `gcloud auth application-default login`
# so the SDK picks up ambient credentials.
GCLOUD_PROJECT=elyxer-dev
VERTEX_REGION=asia-south1

# Model tier — swap to claude-sonnet-4-6 for premium tier later.
CLAUDE_MODEL=claude-haiku-4-5

# Optional: cap generation length. Empty defaults to the model's max.
CLAUDE_MAX_OUTPUT_TOKENS=800
